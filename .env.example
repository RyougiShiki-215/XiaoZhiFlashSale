# ================================================
# 复制本文件为 .env 并填入真实配置
# ================================================

# LLM 提供商选择：deepseek / dashscope / ollama
LLM_PROVIDER=deepseek

# DeepSeek（OpenAI 兼容）
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 阿里百炼 DashScope（OpenAI 兼容模式）
DASHSCOPE_API_KEY=sk-xxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# Ollama 本地模型（可选）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b

# Milvus 向量库（可选；其中任一配置后启用 Milvus，否则回退内存库）
# 本地嵌入式实例（免 Docker）用 MILVUS_LITE_DB，指向本地 .db 文件
MILVUS_LITE_DB=./data/milvus_lite.db
# 远程 Milvus / Zilliz Cloud 用 MILVUS_URI + MILVUS_TOKEN（Lite 与远程二选一）
#MILVUS_URI=http://localhost:19530
#MILVUS_TOKEN=
MILVUS_COLLECTION=xiaozhi
MILVUS_VECTOR_DIM=1024

# Elasticsearch 关键词检索（混合检索 BM25 分支，可选；不启用则纯向量检索）
ES_URI=http://localhost:9200
#ES_HOST=
#ES_PORT=9200
ES_INDEX=xiaozhi
ES_ANALYZER=standard   # 中文可换 ik_max_word（需安装 ik 分词插件）

# Tavily 联网搜索（可选）
TAVILY_API_KEY=tvly-xxx

# Web 服务端口
PORT=8000

# 工具消费方式：local（进程内 BaseTool）| mcp（经自研薄 MCP client 调用）
TOOLS_TRANSPORT=mcp
MCP_SERVER_COMMAND=python
MCP_SERVER_ARGS=-m app.mcp_server --transport stdio

# 工作记忆（graph state）存储：redis（持久到 Redis，每轮图结束自动删除）| memory（仅内存，默认）
# 设为 redis 需确保 REDIS_URL 可达；连不上会自动降级为内存，不影响运行。
STATE_STORE=memory
REDIS_URL=redis://localhost:6379/0

# Skill 根目录（逗号分隔）
SKILLS_ROOTS=./skills
